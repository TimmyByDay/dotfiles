font-family = Paper Mono
theme = Cobalt Next Dark

background-image = bg4.jpg
background-image-opacity = 0.004
background-image-fit = cover


# terminal bindings
keybind = global:cmd+'=toggle_quick_terminal

# window splitting bindings
keybind = alt+-=new_split:down
keybind = alt+==new_split:right
keybind = ctrl+w=close_surface
keybind = ctrl+t=new_tab

# window navigation bindings
keybind = alt+k=goto_split:top
keybind = alt+l=goto_split:right
keybind = alt+j=goto_split:down
keybind = alt+h=goto_split:left
